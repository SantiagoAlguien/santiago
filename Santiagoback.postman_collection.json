    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Set base URL if not already set",
                    "if (!pm.variables.has('base_url')) {",
                    "    pm.variables.set('base_url', 'http://localhost:8080');",
                    "}"
                ]
            }
        },
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Save auth token from login response",
                    "if (pm.response.code === 200 && pm.request.url.getPath().includes('/api/auth/login')) {",
                    "    const jsonData = pm.response.json();",
                    "    if (jsonData && jsonData.token) {",
                    "        pm.variables.set('auth_token', jsonData.token);",
                    "    }",
                    "}"
                ]
            }
        }
    ],
